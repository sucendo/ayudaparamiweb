<!doctype html>
<html dir="ltr" lang="es" xml:lang="es" class="js">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Conversor Binario | Ayuda para mi Web</title>
  <meta name="description" content="Convierte números binarios y decimales y realiza suma y resta de números binarios.">
  <meta name="author" content="Sucender">
  <link rel="canonical" href="https://www.ayudaparamiweb.com/conversor-binario">
  <%- include('../partials/head.ejs') %>
  <link rel="stylesheet" href="/css/tool-pages.css">
</head>
<body id="apmw-body" class="tool-page">
  <div class="ct-container">
    <%- include('../partials/header.ejs') %>

    <div class="ct-content">
      <div class="ct-inner">
        <main class="ct-main ct-main-post tool-v2" id="ct-main" role="main">
          <div class="ct-post">
            <article class="tool-v2-card ct-green">
              <nav class="tool-v2-breadcrumbs" aria-label="Migas de pan">
                <a href="/">Inicio</a><span aria-hidden="true">›</span>
                <a href="/herramientas">Herramientas</a><span aria-hidden="true">›</span>
                <span aria-current="page">Conversor Binario</span>
              </nav>

              <header class="tool-v2-header">
                <a class="tool-v2-category" href="/herramientas">Herramientas</a>
                <h1 class="tool-v2-title">Conversor Binario</h1>
                <p class="tool-v2-intro">Convierte entre binario y decimal y realiza operaciones básicas sin salir de la página.</p>
              </header>

              <figure class="tool-v2-featured">
                <img src="/img/articulo/conversor-binario.png" alt="Conversor Binario">
              </figure>

              <div class="tool-v2-content">
                <h2>Conversión entre binario y decimal</h2>
                <section class="tool-panel">
                  <h3>Binario a decimal</h3>
                  <div class="tool-grid">
                    <div class="tool-field">
                      <label for="binario">Binario</label>
                      <input type="text" id="binario" inputmode="numeric" placeholder="Ejemplo: 101101">
                    </div>
                    <div class="tool-field">
                      <label for="entero">Decimal</label>
                      <input type="text" id="entero" readonly placeholder="Resultado">
                    </div>
                  </div>
                </section>

                <section class="tool-panel">
                  <h3>Decimal a binario</h3>
                  <div class="tool-grid">
                    <div class="tool-field">
                      <label for="decimal">Decimal</label>
                      <input type="number" min="0" step="1" id="decimal" inputmode="numeric" placeholder="Ejemplo: 45">
                    </div>
                    <div class="tool-field">
                      <label for="entero_conv">Binario</label>
                      <input type="text" id="entero_conv" readonly placeholder="Resultado">
                    </div>
                  </div>
                </section>

                <h2>Operaciones aritméticas básicas</h2>
                <section class="tool-panel">
                  <h3>Suma de binarios</h3>
                  <div class="tool-grid tool-grid--4">
                    <div class="tool-field">
                      <label for="sumbin1">Binario 1</label>
                      <input type="text" id="sumbin1" inputmode="numeric" placeholder="1010">
                    </div>
                    <div class="tool-field">
                      <label for="sumbin2">Binario 2</label>
                      <input type="text" id="sumbin2" inputmode="numeric" placeholder="0011">
                    </div>
                    <div class="tool-field">
                      <label for="ressuma">Resultado binario</label>
                      <input type="text" id="ressuma" readonly>
                    </div>
                    <div class="tool-field">
                      <label for="ressumadec">Resultado decimal</label>
                      <input type="text" id="ressumadec" readonly>
                    </div>
                  </div>
                </section>

                <section class="tool-panel">
                  <h3>Resta de binarios</h3>
                  <div class="tool-grid tool-grid--4">
                    <div class="tool-field">
                      <label for="restabin1">Binario 1</label>
                      <input type="text" id="restabin1" inputmode="numeric" placeholder="1010">
                    </div>
                    <div class="tool-field">
                      <label for="restabin2">Binario 2</label>
                      <input type="text" id="restabin2" inputmode="numeric" placeholder="0011">
                    </div>
                    <div class="tool-field">
                      <label for="restatotal">Resultado binario</label>
                      <input type="text" id="restatotal" readonly>
                    </div>
                    <div class="tool-field">
                      <label for="restadec">Resultado decimal</label>
                      <input type="text" id="restadec" readonly>
                    </div>
                  </div>
                </section>

                <h2>¿Qué es el sistema binario?</h2>
                <p>El sistema binario representa los números utilizando únicamente 0 y 1. Es la base de muchas operaciones internas de los sistemas informáticos y permite expresar cualquier número decimal mediante potencias de dos.</p>
              </div>
            </article>
          </div>
        </main>

        <aside class="ct-sidebar"><%- include('../partials/aside.ejs') %></aside>
        <div class="clr"></div>
      </div>
    </div>

    <footer class="ct-footer"><%- include('../partials/footer.ejs') %></footer>
  </div>

  <script>
    (function () {
      function cleanBinary(value) {
        return String(value || '').replace(/[^01]/g, '');
      }

      function binaryToDecimal(value) {
        var clean = cleanBinary(value);
        return clean ? parseInt(clean, 2) : '';
      }

      function decimalToBinary(value) {
        var number = Number(value);
        if (!Number.isFinite(number) || number < 0) return '';
        return Math.floor(number).toString(2);
      }

      function updateConversions() {
        var binary = document.getElementById('binario');
        var decimal = document.getElementById('decimal');
        binary.value = cleanBinary(binary.value);
        document.getElementById('entero').value = binaryToDecimal(binary.value);
        document.getElementById('entero_conv').value = decimalToBinary(decimal.value);
      }

      function updateOperations() {
        var a = cleanBinary(document.getElementById('sumbin1').value);
        var b = cleanBinary(document.getElementById('sumbin2').value);
        document.getElementById('sumbin1').value = a;
        document.getElementById('sumbin2').value = b;

        if (a && b) {
          var sum = parseInt(a, 2) + parseInt(b, 2);
          document.getElementById('ressuma').value = sum.toString(2);
          document.getElementById('ressumadec').value = sum;
        } else {
          document.getElementById('ressuma').value = '';
          document.getElementById('ressumadec').value = '';
        }

        var ra = cleanBinary(document.getElementById('restabin1').value);
        var rb = cleanBinary(document.getElementById('restabin2').value);
        document.getElementById('restabin1').value = ra;
        document.getElementById('restabin2').value = rb;

        if (ra && rb) {
          var diff = parseInt(ra, 2) - parseInt(rb, 2);
          document.getElementById('restadec').value = diff;
          document.getElementById('restatotal').value = diff < 0 ? '-' + Math.abs(diff).toString(2) : diff.toString(2);
        } else {
          document.getElementById('restadec').value = '';
          document.getElementById('restatotal').value = '';
        }
      }

      ['binario', 'decimal'].forEach(function (id) {
        document.getElementById(id).addEventListener('input', updateConversions);
      });

      ['sumbin1', 'sumbin2', 'restabin1', 'restabin2'].forEach(function (id) {
        document.getElementById(id).addEventListener('input', updateOperations);
      });
    })();
  </script>
</body>
</html>
