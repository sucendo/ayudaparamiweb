<%
  const all = contentItems || [];
  const pick = function(slug) { return all.find(function(item) { return item.slug === slug; }); };
  const startItems = [
    pick('como-crear-una-pagina-web'),
    pick('seo-que-es'),
    pick('checklist-lanzamiento-web-2026')
  ].filter(Boolean);
  const tools = all.filter(function(item) { return item.category === 'herramientas'; }).slice(0, 4);
  const labs = all.filter(function(item) { return item.category === 'laboratorio'; }).slice(0, 2);
  const latest = all.slice().sort(function(a, b) {
    return new Date(b.publishedDate || '1970-01-01').getTime() - new Date(a.publishedDate || '1970-01-01').getTime();
  }).slice(0, 8);
%>
<!doctype html>
<html dir="ltr" lang="es" xml:lang="es" class="js js canvas fontface generatedcontent">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Demo de portada | Ayuda para mi Web</title>
    <meta name="description" content="Demo visual privada de una posible nueva portada para Ayuda para mi Web." />
    <meta name="robots" content="noindex,nofollow">
    <meta name="author" content="Sucender" />
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/home-demo.css">
  </head>
  <body id="apmw-body" class="home-demo home-demo--intermediate">
    <div class="ct-container">
      <%- include('../partials/header.ejs') %>

      <div class="ct-content">
        <div class="ct-inner">
          <main class="ct-main ct-main-archive home-demo-main" role="main">

            <section class="home-demo-intro ct-box ct-green">
              <div class="ct-box-inner">
                <span class="home-demo-kicker">Ayuda para mi Web</span>
                <h1>Aprende, crea y mejora tu web</h1>
                <p class="home-demo-intro__lead">Artículos, tutoriales, herramientas y experimentos para resolver problemas reales de desarrollo web y SEO.</p>
                <div class="home-demo-intro__actions">
                  <a href="/articulos">Ver artículos</a>
                  <a href="/tutoriales">Seguir tutoriales</a>
                  <a href="/herramientas">Usar herramientas</a>
                </div>
              </div>
            </section>

            <section class="home-demo-block" aria-labelledby="demo-sections-title">
              <header class="home-demo-heading">
                <h2 id="demo-sections-title">¿Qué estás buscando?</h2>
                <p>La misma estructura de Ayuda para mi Web, pero con una entrada algo más clara a cada sección.</p>
              </header>

              <div class="home-demo-categories">
                <a class="ct-box ct-blue home-demo-category" href="/articulos">
                  <div class="ct-box-inner">
                    <span class="home-demo-category__eyebrow">Entender</span>
                    <h3>Artículos</h3>
                    <p>Conceptos, análisis y criterios para tomar mejores decisiones.</p>
                    <strong>Explorar artículos →</strong>
                  </div>
                </a>

                <a class="ct-box ct-orange home-demo-category" href="/tutoriales">
                  <div class="ct-box-inner">
                    <span class="home-demo-category__eyebrow">Hacer</span>
                    <h3>Tutoriales</h3>
                    <p>Procesos paso a paso para conseguir un resultado concreto.</p>
                    <strong>Ver tutoriales →</strong>
                  </div>
                </a>

                <a class="ct-box ct-purple home-demo-category" href="/herramientas">
                  <div class="ct-box-inner">
                    <span class="home-demo-category__eyebrow">Resolver</span>
                    <h3>Herramientas</h3>
                    <p>Utilidades prácticas para analizar, validar y trabajar más rápido.</p>
                    <strong>Abrir herramientas →</strong>
                  </div>
                </a>

                <a class="ct-box ct-red home-demo-category" href="/laboratorio">
                  <div class="ct-box-inner">
                    <span class="home-demo-category__eyebrow">Experimentar</span>
                    <h3>Laboratorio</h3>
                    <p>Pruebas reales, hipótesis, resultados y experimentos históricos.</p>
                    <strong>Entrar al Laboratorio →</strong>
                  </div>
                </a>
              </div>
            </section>

            <% if (startItems.length) { %>
            <section class="home-demo-block" aria-labelledby="demo-start-title">
              <header class="home-demo-heading">
                <h2 id="demo-start-title">Empieza por aquí</h2>
                <p>Tres contenidos útiles para quien llega a la web por primera vez.</p>
              </header>
              <div class="home-demo-start">
                <% startItems.forEach(function(item) { %>
                  <article class="ct-box <%= item.colorClass || 'ct-blue' %> home-demo-start__card">
                    <div class="ct-box-inner">
                      <span class="home-demo-category__eyebrow"><%= categories[item.category] ? categories[item.category].name : item.category %></span>
                      <h3><a href="<%= item.path %>"><%= item.title %></a></h3>
                      <p><%= item.excerpt %></p>
                    </div>
                  </article>
                <% }); %>
              </div>
            </section>
            <% } %>

            <% if (tools.length || labs.length) { %>
            <section class="home-demo-block home-demo-split" aria-label="Herramientas y Laboratorio">
              <% if (tools.length) { %>
              <div class="home-demo-split__column">
                <header class="home-demo-heading">
                  <h2>Herramientas</h2>
                  <p>Accesos rápidos a algunas utilidades.</p>
                </header>
                <div class="home-demo-simple-list">
                  <% tools.forEach(function(item) { %>
                    <a href="<%= item.path %>">
                      <span><%= item.title %></span>
                      <b>→</b>
                    </a>
                  <% }); %>
                </div>
                <p class="home-demo-more"><a href="/herramientas">Ver todas las herramientas</a></p>
              </div>
              <% } %>

              <% if (labs.length) { %>
              <div class="home-demo-split__column">
                <header class="home-demo-heading">
                  <h2>Laboratorio</h2>
                  <p>Los experimentos más recientes del proyecto.</p>
                </header>
                <div class="home-demo-simple-list home-demo-simple-list--lab">
                  <% labs.forEach(function(item) { %>
                    <a href="<%= item.path %>">
                      <span><%= item.title %></span>
                      <b>→</b>
                    </a>
                  <% }); %>
                </div>
                <p class="home-demo-more"><a href="/laboratorio">Ver todo el Laboratorio</a></p>
              </div>
              <% } %>
            </section>
            <% } %>

            <section class="home-demo-block home-demo-latest" aria-labelledby="demo-latest-title">
              <header class="home-demo-heading">
                <h2 id="demo-latest-title">Últimas publicaciones</h2>
                <p>El listado conserva prácticamente el mismo aspecto actual de la web.</p>
              </header>
              <div class="ct-archive-container">
                <%- include('../partials/content-grid.ejs', { items: latest, categories: categories }) %>
              </div>
              <div class="clr"></div>
            </section>

          </main>

          <aside class="ct-sidebar"><%- include('../partials/aside.ejs') %></aside>
          <div class="clr"></div>
        </div>
      </div>

      <footer class="ct-footer"><%- include('../partials/footer.ejs') %></footer>
    </div>
  </body>
</html>
