<%
  const formatDate = function(dateString) {
    const parts = String(dateString || '').split('-');
    return parts.length === 3 ? parts[2] + '/' + parts[1] + '/' + parts[0] : dateString;
  };
  const tone = metadata.labToneClass || metadata.toolToneClass || 'ct-purple';
%>

<div class="ct-main ct-main-post article-v2 lab-v2" id="ct-main" role="main">
  <article class="ct-post post type-post status-publish format-standard has-post-thumbnail hentry article-v2-card lab-v2-card <%= tone %>">

    <nav class="article-breadcrumbs lab-breadcrumbs" aria-label="Migas de pan">
      <% (metadata.breadcrumb || []).forEach(function(item, index) { %>
        <% if (index > 0) { %><span aria-hidden="true">›</span><% } %>
        <% if (index < metadata.breadcrumb.length - 1) { %>
          <a href="<%= item.url %>"><%= item.name %></a>
        <% } else { %>
          <span aria-current="page"><%= item.name %></span>
        <% } %>
      <% }); %>
    </nav>

    <header class="article-v2-header lab-v2-header">
      <div class="lab-kicker-row">
        <a class="article-v2-category lab-kicker" href="/laboratorio">Laboratorio</a>
        <% if (metadata.status) { %><span class="lab-status"><%= metadata.status %></span><% } %>
      </div>

      <h1 class="ct-h-shd entry-title"><%= metadata.title %></h1>
      <p class="ct-post-excerpt article-v2-excerpt lab-v2-excerpt"><%= metadata.description %></p>

      <div class="article-v2-meta lab-meta">
        <span>Por <a href="/sucender"><%= metadata.author || 'Sucender' %></a></span>
        <% if (metadata.publishedDate) { %>
          <span aria-hidden="true">·</span>
          <span>Publicado el <%= formatDate(metadata.publishedDate) %></span>
        <% } %>
        <% if (metadata.modifiedDate && metadata.modifiedDate !== metadata.publishedDate) { %>
          <span aria-hidden="true">·</span>
          <span>Actualizado el <%= formatDate(metadata.modifiedDate) %></span>
        <% } %>
      </div>
    </header>

    <% if (metadata.featuredImage) { %>
      <figure class="ct-post-featured-img article-v2-featured lab-featured <%= tone %>">
        <img src="<%= metadata.featuredImage %>" alt="<%= metadata.title %>" fetchpriority="high">
      </figure>
    <% } %>

    <% if (metadata.hypothesis) { %>
      <aside class="lab-hypothesis">
        <span>Hipótesis del experimento</span>
        <strong><%= metadata.hypothesis %></strong>
      </aside>
    <% } %>

    <div class="ct-post-content article-v2-content lab-content">
      <% (metadata.sections || []).forEach(function(section) { %>
        <section class="lab-section">
          <h2><%= section.title %></h2>
          <% if (Array.isArray(section.paragraphs)) { %>
            <% section.paragraphs.forEach(function(paragraph) { %><p><%= paragraph %></p><% }); %>
          <% } else if (section.content) { %>
            <p><%= section.content %></p>
          <% } %>

          <% if (Array.isArray(section.steps) && section.steps.length) { %>
            <ol class="lab-steps">
              <% section.steps.forEach(function(step) { %><li><%= step %></li><% }); %>
            </ol>
          <% } %>

          <% if (section.table && Array.isArray(section.table.headers) && Array.isArray(section.table.rows)) { %>
            <div class="lab-table-wrap">
              <table class="lab-results-table">
                <thead>
                  <tr><% section.table.headers.forEach(function(header) { %><th><%= header %></th><% }); %></tr>
                </thead>
                <tbody>
                  <% section.table.rows.forEach(function(row) { %>
                    <tr><% row.forEach(function(cell) { %><td><%= cell %></td><% }); %></tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
      <% }); %>

      <% if (metadata.experimentUrl || (Array.isArray(metadata.experimentLinks) && metadata.experimentLinks.length)) { %>
        <section class="lab-experiment-cta" aria-labelledby="lab-experiment-title">
          <span class="lab-experiment-cta__eyebrow">Experimento</span>
          <h2 id="lab-experiment-title"><%= metadata.experimentTitle || 'Prueba el experimento' %></h2>
          <p><%= metadata.experimentDescription || 'La implementación sigue disponible dentro de Ayuda para mi Web.' %></p>
          <% if (Array.isArray(metadata.experimentLinks) && metadata.experimentLinks.length) { %>
            <div class="lab-experiment-links">
              <% metadata.experimentLinks.forEach(function(item) { %>
                <a class="lab-experiment-button" href="<%= item.url %>"><%= item.label %> →</a>
              <% }); %>
            </div>
          <% } else { %>
            <a class="lab-experiment-button" href="<%= metadata.experimentUrl %>"><%= metadata.experimentLabel || 'Abrir experimento' %> →</a>
          <% } %>
        </section>
      <% } %>

      <% (metadata.resultsSections || []).forEach(function(section) { %>
        <section class="lab-section lab-section--results">
          <h2><%= section.title %></h2>
          <% if (Array.isArray(section.paragraphs)) { %>
            <% section.paragraphs.forEach(function(paragraph) { %><p><%= paragraph %></p><% }); %>
          <% } else if (section.content) { %>
            <p><%= section.content %></p>
          <% } %>
        </section>
      <% }); %>
    </div>

    <% if ((metadata.tags || []).length) { %>
      <p class="ct-tags lab-tags">
        <span class="ct-tags-label">Etiquetado en:</span>
        <% metadata.tags.forEach(function(tag) { %><span><%= tag %></span><% }); %>
      </p>
    <% } %>
  </article>
</div>

<aside class="ct-sidebar article-sidebar lab-sidebar"><%- include('../partials/aside.ejs') %></aside>
